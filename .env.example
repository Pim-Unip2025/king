# Transaction pooler do Supabase (porta 6543).
# NAO colocar sslmode aqui: a connection string sobrescreve o objeto ssl do codigo.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

PORT=3000

# Validade do access token, em segundos (padrao: 3600 = 1h)
JWT_EXPIRES_IN=3600

# Enquanto nao houver SMS de verdade, POST /auth/forgot-password devolve o
# codigo de 6 digitos na resposta (como a tela atual faz). So "true" liga.
SIMULAR_SMS=false

# Origens que podem chamar a API pelo navegador, separadas por virgula.
# Ex.: https://tronus.vercel.app,http://localhost:5500 — nunca "*".
CORS_ORIGINS=""
